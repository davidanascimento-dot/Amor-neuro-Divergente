xQ5s0 {\n  position: absolute;\n  right: 0;\n  top: 0;\n  width: 50%;\n  height: 100%;\n  border-top-right-radius: 1px;\n  border-bottom-right-radius: 1px;\n  background: url('data:image/svg+xml;utf8,%3Csvg%20width%3D%226%22%20height%3D%226%22%20viewBox%3D%220%200%206%206%22%20fill%3D%22none%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cpath%20d%3D%22M0%200H3V3H0V0Z%22%20fill%3D%22%23E1E1E1%22/%3E%3Cpath%20d%3D%22M3%200H6V3H3V0Z%22%20fill%3D%22white%22/%3E%3Cpath%20d%3D%22M3%203H6V6H3V3Z%22%20fill%3D%22%23E1E1E1%22/%3E%3Cpath%20d%3D%22M0%203H3V6H0V3Z%22%20fill%3D%22white%22/%3E%3C/svg%3E%0A');\n}\n\n.chit--chit---D2JR {\n  border-radius: 1px;\n\n  overflow: hidden;\n  position: relative;\n  flex-shrink: 0;\n  height: 16px;\n  width: 16px;\n}\n\n[data-fpl-version='ui3'] .chit--chit---D2JR, :where([data-fpl-ui3-override]) .chit--chit---D2JR {\n    /* Set similarly to the chit border defined below */\n    border-radius: 20%;\n}\n\n.chit--chit---D2JR:focus-visible::after {\n    content: '';\n\n    /* Render a border using a shadow on top of the content in .chit */\n    position: absolute;\n    inset: 0;\n    box-shadow: inset 0 0 0 1px var(--color-border-selected);\n    transform: scale(1);\n  }\n\n.chit--chitBorder---ff5t {\n  position: absolute;\n\n  /* Our goal is to draw a 0.5px \"hairline\" border around these chits. However, Chrome\n      doesn't support sub-pixel borders and Safari doesn't support sub-pixel box-shadows,\n      so we use this hack where we draw a 1px box at twice the size and then scale it down. */\n  top: -50%;\n  left: -50%;\n  right: -50%;\n  bottom: -50%;\n  box-shadow: inset 0 0 0 1px var(--color-border);\n  transform-origin: center center;\n  transform: scale(0.5);\n}\n\n[data-fpl-version='ui3'] .chit--chitBorder---ff5t, :where([data-fpl-ui3-override]) .chit--chitBorder---ff5t {\n    /* Border radius is a percentage instead of an actual value since we render chits\n    at various sizes (see: gridVariableChit), this ensures its always the right radius no matter the size */\n    border-radius: 20%;\n}\n\n/* The above fix looks good everywhere except in FireFox on low-density displays. In that\n   case, we just throw our hands in the air and render a 1px border around the chit. */\n\n@media screen and (max-resolution: 1.5dppx) {\n  @supports (-moz-appearance: none) {\n    .chit--chitBorder---ff5t {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      box-shadow: inset 0 0 0 1px var(--color-border);\n      transform: none;\n    }\n  }\n}\n"},886287(e,t,r){r.d(t,{$:()=>y,$f:()=>o,As:()=>f,Bx:()=>b,DQ:()=>O,Gz:()=>c,K5:()=>a,LK:()=>S,Om:()=>s,UU:()=>m,Ul:()=>A,VB:()=>d,ZM:()=>E,ab:()=>i,bE:()=>v,cZ:()=>l,fz:()=>h,it:()=>I,lF:()=>g,mL:()=>T,n:()=>n,vQ:()=>_,y4:()=>p,yW:()=>u,zz:()=>C});let n="colors_inspect_panel--colorContainer--RM4cT",i="colors_inspect_panel--colorContainerUI3--oxjqp colors_inspect_panel--colorContainer--RM4cT",a="colors_inspect_panel--propertyColorRowTall---HNAm colors_inspect_panel--_propertyColorRow--BnwRn inspection_property--tallPropertyRow--0tB0Q inspection_property--_basePropertyRow--H4A-x inspection_property--tallRow--4VFZa",o="colors_inspect_panel--propertyColorRowTallUI3--TLkdk colors_inspect_panel--_propertyColorRow--BnwRn inspection_property--tallPropertyRow--0tB0Q inspection_property--_basePropertyRow--H4A-x inspection_property--tallRow--4VFZa",s="colors_inspect_panel--propertyColorRowShortUI3--eZdka colors_inspect_panel--_propertyColorRow--BnwRn inspection_property--basePropertyRow--khFIk inspection_property--_basePropertyRow--H4A-x",l="colors_inspect_panel--propertyRowTwoColumn--EPhf4",d="colors_inspect_panel--styleNameRow--77jz8 inspection_property--tallPropertyRow--0tB0Q inspection_property--_basePropertyRow--H4A-x inspection_property--tallRow--4VFZa",c="colors_inspect_panel--paintIcon---6IgI",u="colors_inspect_panel--paintName--AQ5sY ellipsis--ellipsis--IdJAr",p="colors_inspect_panel--styleNameContainer--Zna-1 inspectio